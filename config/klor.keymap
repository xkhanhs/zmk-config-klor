#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// KLOR Saegewerk, 36 keys: the Corne layout from xkhanhs/zmk-config-corne,
// except the ;/: key on BASE and the right hand of FN. This file matches what
// was saved in ZMK Studio on 2026-10-25.
// Firmware sends QWERTY keycodes; on the host VTX (Colemak mode) remaps them
// to Colemak DH-Viet, so the comments show the character under DH-Viet.
//
// The shield maps only the 36 keys of the build, in the Corne 5-column order:
// three rows of 5 + 5, then left thumbs outer -> inner and right thumbs
// inner -> outer. ZMK Studio is enabled on the left half.
//
// No reset button is fitted: FN + the left top-left key or the right
// bottom-right key reboots that half into the bootloader.

#define XXX &none

/ {
	behaviors {
		nav_shift: nav_shift {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			// balanced: a key pressed and released while NAV is down makes it
			// a hold at once, so NAV + digit or arrow does not wait.
			flavor = "balanced";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&sk>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "BASE";
			// The ; key of DH-Viet sends Shift so it types ":"; plain ";" is on FN.
			// |  q  |  w  |  f  |  g  |  b  |   |  :  |  l  |  u  |  y  |  x  |
			// |  a  |  h  |  s  |  t  |  p  |   |  m  |  n  |  e  |  o  |  i  |
			// |  j  |  v  |  r  |  c  |  z  |   |  k  |  d  |  ,  |  .  |  /  |
			//       | GUI |NAV/⇧| SPC |   | BSPC| SHFT| ENT |
			bindings = <
&kp Q &kp W &kp E &kp R &kp T   &kp LS(Y) &kp U &kp I &kp O   &kp P
&kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K     &kp L   &kp SEMI
&kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH
      &kp LGUI &nav_shift 1 LSHFT &kp SPACE   &kp BSPC &kp LSHFT &kp RET
			>;
		};

		nav_layer {
			display-name = "NAV";
			// Left hand moves, right hand is a numpad. CMDTAB returns to the
			// last app in one press, SHOT4 is Cmd+Shift+4, FN is held on top
			// of NAV, DELW deletes a word (Alt+Backspace).
			// | ESC  |  [   |  UP  |  ]   | TAB  |   |  /   |  7   |  8   |  9   |  -   |
			// | GUI  | LEFT | DOWN | RGHT |CMDTAB|   |  *   |  4   |  5   |  6   |  +   |
			// | SHFT |  (   |  )   | SHOT4|  FN  |   |  =   |  1   |  2   |  3   |  .   |
			//               |      | held |      |   | DELW |  0   | S-ENT|
			bindings = <
&kp ESC   &kp LBKT &kp UP   &kp RBKT       &kp TAB       &kp FSLH  &kp N7 &kp N8 &kp N9 &kp MINUS
&kp LGUI  &kp LEFT &kp DOWN &kp RIGHT      &kp LG(TAB)   &kp STAR  &kp N4 &kp N5 &kp N6 &kp PLUS
&kp LSHFT &kp LPAR &kp RPAR &kp LG(LS(N4)) &mo 2         &kp EQUAL &kp N1 &kp N2 &kp N3 &kp DOT
                   &trans   &trans         &trans        &kp LA(BSPC) &kp N0 &kp LS(RET)
			>;
		};

		fn_layer {
			display-name = "FN";
			// Everything usable is on the right hand: the left hand holds NAV
			// and FN. Empty cells are &none so a stray touch does not type a
			// NAV digit. BTCLR clears the selected Bluetooth profile. C-4 and
			// C-3 pick an input source directly (on the Corne they sit on the
			// outer column, which the KLOR does not have). BOOT reboots that
			// half into the bootloader for flashing. The ; cell sends Y, which
			// is ; on DH-Viet.
			// | BOOT |      |      |      |      |   |  ;   |  @   | MUTE | BRI+ | BTCLR|
			// |      |      |      |      |      |   |  "   |  ?   | VOL+ | BRI- |      |
			// |      |      |      |      | held |   | C-c  | C-4  | VOL- | C-3  | BOOT |
			bindings = <
&bootloader XXX XXX XXX XXX      &kp Y      &kp AT     &kp C_MUTE   &kp C_BRI_UP &bt BT_CLR
XXX         XXX XXX XXX XXX      &kp DQT    &kp QMARK  &kp C_VOL_UP &kp C_BRI_DN XXX
XXX         XXX XXX XXX &trans   &kp LC(V)  &kp LC(N4) &kp C_VOL_DN &kp LC(N3)   &bootloader
            &trans &trans &trans   &trans &trans &trans
			>;
		};
	};
};
